local function gerstnerWave(x, z, t, amplitude, wavelength, speed, direction, phaseOffset)
	local k = (2 * math.pi) / wavelength  -- Wave number
	local w = speed   -- Angular frequency

	local dotProduct = k * (direction.x * x + direction.z * z) + w * t + phaseOffset
	local cosWave = math.cos(dotProduct)
	local sinWave = math.sin(dotProduct)

	-- Horizontal displacement
	local dispX = amplitude * direction.x * cosWave
	local dispZ = amplitude * direction.z * cosWave

	-- Vertical displacement (height)
	local dispY = amplitude * sinWave

	return Vector3.new(dispX, dispY, dispZ)
end


