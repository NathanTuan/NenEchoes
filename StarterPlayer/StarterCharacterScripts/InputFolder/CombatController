local userInput = game:GetService("UserInputService")
local rs = game:GetService("ReplicatedStorage")
local players = game:GetService("Players")

local player = players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local animator = humanoid:WaitForChild("Animator")

local m1Event = rs.RemoteEvents.CombatEvents.M1
local rollEvent = rs.RemoteEvents.MovementEvents.RollEvent
local blockEvent = rs.RemoteEvents.CombatEvents.BlockEvent
local unblockEvent = rs.RemoteEvents.CombatEvents.UnblockEvent

local GameModules = require(rs.GameModules)
local combatAnimModule = require(script.Parent:WaitForChild("combatAnimsModule")) -- adjust path as needed

local mouse = player:GetMouse()
local m1ing = false
local wantToBlock = true

-- Update reference on character reset
player.CharacterAdded:Connect(function(newChar)
	character = newChar
	humanoid = character:WaitForChild("Humanoid")
	animator = humanoid:WaitForChild("Animator")
end)

local function playClientM1()
	if character:GetAttribute("Stunned") or character:GetAttribute("Cooldown") or character:GetAttribute("Busy") then
		return
	end

	local combo = character:GetAttribute("Combo") 
	local anims = combatAnimModule:GetAnimations(character)

	local clipKey = (character:GetAttribute("Airtilting") ~= -1 and combo > 3) and ("M1_" .. combo .. "_Airtilt") or ("M1_" .. combo)
	local clip = anims[clipKey]

	if clip then
		if combo == 1 then clip:AdjustSpeed(1.4) end
		clip:Play(0.05)
		m1Event:FireServer(clip.Length)
	else
		m1Event:FireServer(0.4)
	end
end

userInput.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	-- Mouse 1 / M1 Actions
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if character:GetAttribute("AbilityEnabled") == false then
			if character:GetAttribute("M1Activated") == true then
				if not m1ing then
					m1ing = true
					task.spawn(function()
						while m1ing do
							playClientM1()
							task.wait(0.1)
						end
					end)
				end
			end
		else
			local weapon = character:GetAttribute("Weapon")
			local nenAbility = character:GetAttribute("NenAbility")

			if nenAbility == "Kite" then
				if weapon == "SpawnedGun" and not m1ing then
					m1ing = true
					task.spawn(function()
						while m1ing do
							rs.RemoteEvents.NenAbilities.KiteMoves.SpawnedGun.FireGun:FireServer(mouse.Hit.Position)
							task.wait(0.1)
						end
					end)
				elseif weapon == "SpawnedScythe" and not m1ing then
					m1ing = true
					task.spawn(function()
						while m1ing do
							rs.RemoteEvents.NenAbilities.KiteMoves.SpawnedScythe.ScytheM1Event:FireServer(mouse.Hit.Position)
							task.wait(0.1)
						end
					end)
				end
			else
				if not m1ing then
					m1ing = true
					task.spawn(function()
						while m1ing do
							playClientM1()
							task.wait(0.1)
						end
					end)
				end
			end
		end
	end

	
	-- Keybind B
	if input.KeyCode == Enum.KeyCode.B then
		rs.RemoteEvents.CombatEvents.GripEvent:FireServer()
	end

	-- Blocking Key
	if input.KeyCode == Enum.KeyCode.F then
		wantToBlock = true
		blockEvent:FireServer()
		local anims = combatAnimModule:GetAnimations(character)
		if anims.blockStart then anims.blockStart:Play(0.05) end
		task.delay(0.33, function()
			if wantToBlock == true then
				anims.block:Play(0.1)
			end
		end)
	end
end)

userInput.InputEnded:Connect(function(input, gameProcessed)
	if gameProcessed then return end


	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		m1ing = false
	end

	if input.KeyCode == Enum.KeyCode.F then
		unblockEvent:FireServer()
		local anims = combatAnimModule:GetAnimations(character)
		if anims.block then anims.block:Stop(0.1) end
		wantToBlock = false
	end
end)

-- Events
rs.RemoteEvents.CombatEvents.Ragdoll.OnClientEvent:Connect(function(bool)
	if bool then
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		humanoid.PlatformStand = true
	else
		humanoid.PlatformStand = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end)

rs.RemoteEvents.NPCEvents.EnemyEvents.UpdateContributors.OnClientEvent:Connect(function(enemyNPC, damage)
	rs.RemoteEvents.NPCEvents.EnemyEvents.UpdateContributors:FireServer(enemyNPC, damage)
end)
