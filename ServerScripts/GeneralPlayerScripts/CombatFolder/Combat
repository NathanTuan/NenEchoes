local function yieldAllBut(hum, anim)
	for i, v in pairs(hum:GetPlayingAnimationTracks()) do

		if v.Name ~= anim and v.Name ~= "idleAnim" then
			v:Stop()
			v:Destroy()
		end
	end
end
