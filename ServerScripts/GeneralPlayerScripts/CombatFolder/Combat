local players = game:GetService("Players")
local rs = game:GetService("ReplicatedStorage")
local debris = game:GetService("Debris")

local m1Event = rs.RemoteEvents.CombatEvents.M1
local blockEvent = rs.RemoteEvents.CombatEvents.BlockEvent
local unblockEvent = rs.RemoteEvents.CombatEvents.UnblockEvent
local airtiltEvent = rs.RemoteEvents.CombatEvents.AirtiltEvent
local activateM1Event = rs.RemoteEvents.CombatEvents.ActivateM1Event

local hitEffectTemplate = rs.VFX.CombatVFX.WindImpactVFX
local GameModules = require(rs.GameModules)
local GeneralModule = GameModules.GeneralModule
local ragdollModule = GameModules.RagdollModule
local SFXModule = GameModules.SFXModule

local m1CheckList = {"Stunned", "Cooldown", "Blocking", "Charging", "Busy", "Swimming", "Incapacitated"}
local wantToBlock = {}

local function createHitbox(rootPart)
	local hitbox = Instance.new("Part")
	hitbox.Size = Vector3.new(5, 6, 5)
	hitbox.Transparency = 1
	hitbox.CanCollide = false
	hitbox.CanQuery = false
	hitbox.Anchored = true
	hitbox.CFrame = rootPart.CFrame * CFrame.new(0, 0, -3)
	hitbox.Name = "Hitbox"
	hitbox.Parent = workspace

	debris:AddItem(hitbox, 0.2)
	return hitbox
end

local function castHitbox(player, combo)
	local character = player.Character
	if not character or not character.PrimaryPart then return end

	local rootPart = character.PrimaryPart
	local hitbox = createHitbox(rootPart)

	local hitboxParams = OverlapParams.new()
	hitboxParams.FilterDescendantsInstances = {character, hitbox}
	hitboxParams.FilterType = Enum.RaycastFilterType.Exclude
	hitboxParams.MaxParts = 50

	local partsInBox = workspace:GetPartBoundsInBox(hitbox.CFrame, hitbox.Size, hitboxParams)
	local hitPlayers = {}

	for _, v in ipairs(partsInBox) do
		local targetChar = v.Parent
		local hum = targetChar:FindFirstChild("Humanoid")

		if hum and not hitPlayers[targetChar] then	
			hitPlayers[targetChar] = true
			if targetChar:GetAttribute("Invincible") then continue end

			local damage = 0

			-- PARRY LOGIC
			if targetChar:GetAttribute("Parrying") then
				local parryFX = rs.VFX.CombatVFX.parryFX:Clone()
				local arm = targetChar:FindFirstChild("Left Arm")
				if arm then
					parryFX.Position = arm.Position + (arm.CFrame.RightVector * 1)
					local m6D = Instance.new("Motor6D")
					m6D.Part0 = arm
					m6D.Part1 = parryFX
					m6D.C1 = CFrame.new(0, 0, 1)
					m6D.Parent = arm
					debris:AddItem(m6D, 3)
				end

				parryFX.Parent = workspace
				debris:AddItem(parryFX, 3)

				task.defer(function()
					for _, att in ipairs(parryFX:GetChildren()) do
						for _, emitter in ipairs(att:GetChildren()) do
							emitter:Emit(emitter:GetAttribute("EmitCount") or 1)
						end
					end
				end)

				SFXModule:PlaySFX("ParrySFX", character.SFX.ActionSFX)
				GeneralModule.stun(character, 1.2, false)
				GeneralModule.stun(targetChar, 0.8, false)
				hum.Animator:LoadAnimation(rs.Animations.M1Anims.BlockParry):Play()
				return

					-- BLOCK LOGIC
			elseif targetChar:GetAttribute("Blocking") then
				SFXModule:PlaySFX("M1BlockedSFX", character.SFX.ActionSFX)
				if combo == 5 then
					damage = 8
					GeneralModule.blockbreak(targetChar)
					GeneralModule.createHitEffect(targetChar.PrimaryPart.Position + Vector3.new(0, 0.9, -1.5), hitEffectTemplate)
					GeneralModule.stun(targetChar, 2, false)
				else
					damage = 2
					task.delay(0.05, function()
						local vfx = rs.VFX.CombatVFX.BlockHitVFX:Clone()
						vfx.Position = targetChar.PrimaryPart.Position + Vector3.new(0, 0.9, -1.5)
						vfx.Parent = workspace
						debris:AddItem(vfx, 1)
						for _, emitter in ipairs(vfx:GetDescendants()) do
							if emitter:IsA("ParticleEmitter") then
								emitter:Emit(emitter:GetAttribute("EmitCount") or 1)
							end
						end
					end)
				end

				-- CLEAN HIT LOGIC
			else
				SFXModule:PlaySFX("M1HitSFX", character.SFX.ActionSFX)
				local str = (player:FindFirstChild("Stats") and player.Stats.Strength.Value) or 0

				if combo == 5 then
					if character:GetAttribute("Airtilting") == 1 then
						GeneralModule.stun(targetChar, 1.5)
						local lv = targetChar.PrimaryPart:FindFirstChild("UptiltLv")
						if lv then
							local origin = rootPart.Position
							local direction = Vector3.new(rootPart.CFrame.LookVector.X, -0.65, rootPart.CFrame.LookVector.Z).Unit * 100

							local downslamVFX = rs.VFX.CombatVFX.DownslamVFX:Clone()
							downslamVFX.CFrame = CFrame.lookAt(origin, origin + direction)
							downslamVFX.Parent = workspace
							debris:AddItem(downslamVFX, 3)

							local raycastParams = RaycastParams.new()
							raycastParams.FilterType = Enum.RaycastFilterType.Exclude
							raycastParams.FilterDescendantsInstances = {character, targetChar}
							local result = workspace:Raycast(origin, direction, raycastParams)

							if result and result.Instance then
								local dist = (result.Position - targetChar.PrimaryPart.Position).Magnitude
								local speed = 90
								lv.VectorVelocity = (result.Position - targetChar.PrimaryPart.Position).Unit * speed

								task.delay(dist / speed, function()
									lv.VectorVelocity = Vector3.new(0, 0, 0)
									game:GetService("Debris"):AddItem(lv, 1)
									SFXModule:PlaySFX("GroundSlamSFX" .. math.random(1, 2), character.SFX.ActionSFX)
									GeneralModule.spawnCrater(targetChar.PrimaryPart, 2)
									GeneralModule.stun(targetChar, 1.2, false)
									ragdollModule:Ragdoll(targetChar, 1)
									GeneralModule.removeAttackingState(character)
								end)

								local myLv = rootPart:FindFirstChild("UptiltLv")
								if myLv then myLv:Destroy() end
							end
						end
						character:SetAttribute("Airtilting", -1)
					else
						GeneralModule.knockback(character, targetChar, 40)
						ragdollModule:Ragdoll(targetChar, 1)
						GeneralModule.stun(targetChar, 1.3)
						character:SetAttribute("Airtilting", -1)
					end
					damage = 8 + (str * 0.3)
				else
					if combo > 3 and character:GetAttribute("Airtilting") == 0 then
						character:SetAttribute("Airtilting", 1)

						local function createUptiltLV(parentPart)
							local lv = Instance.new("LinearVelocity")
							lv.Name = "UptiltLv"
							lv.Attachment0 = parentPart:FindFirstChild("RootAttachment") or Instance.new("Attachment", parentPart)
							lv.MaxForce = 1e10
							lv.VectorVelocity = Vector3.new(0, 70, 0)
							lv.Parent = parentPart
							task.delay(0.15, function()
								if lv then lv.VectorVelocity = Vector3.zero end
							end)
							return lv
						end

						createUptiltLV(rootPart)
						createUptiltLV(targetChar.PrimaryPart)
						debris:AddItem(targetChar.PrimaryPart:FindFirstChild("UptiltLv"), 3)
					end

					damage = 5 * (1 + (str * 0.05))
					GeneralModule.stun(targetChar, 0.8)
					GeneralModule.knockback(character, targetChar, 10)
				end

				GeneralModule.createHitEffect(hum.Parent.PrimaryPart.Position + Vector3.new(0, 0.7, 0), hitEffectTemplate)
			end

			GeneralModule.damageLooks(player, v, damage)
			hum:TakeDamage(damage)
			rs.RemoteEvents.NPCEvents.EnemyEvents.UpdateContributors:FireClient(player, hum.Parent, damage)
		end
	end
end

activateM1Event.OnServerEvent:Connect(function(player)
	if player.Character then
		player.Character:SetAttribute("M1Activated", not player.Character:GetAttribute("M1Activated"))
	end
end)

-- M1 EVENT (Server Hit Processing/Cooldown Management)
m1Event.OnServerEvent:Connect(function(player, animLength)
	local character = player.Character
	if not character or not GeneralModule.checkAll(player, m1CheckList) then return end

	local combo = character:GetAttribute("Combo") 
	local m1Speed = animLength or 0.4

	character:SetAttribute("Cooldown", true)
	character:SetAttribute("Busy", true)
	character:SetAttribute("Sprinting", false)
	GeneralModule.applyAttackingState(character, 0.7)
	GeneralModule.addSpeedBuff(player, "M1SpeedBuff", -12)

	SFXModule:PlaySFX("M1SFX", character.SFX.ActionSFX)

	if combo < 5 then
		GeneralModule.knockback(character, character, 10)
	end

	--hitbox delay calculation
	local hitDelay
	if combo == 5 then
		hitDelay = m1Speed * 0.65
	else 
		if combo == 4 and player.Character:GetAttribute("Airtilting") == 0 then
			hitDelay = m1Speed * 0.45
		else 
			hitDelay = m1Speed * 0.35
		end
	
	end
	task.delay(hitDelay, function()
		if character and not character:GetAttribute("Stunned") then
			castHitbox(player, combo)
		end
	end)

	-- Increment combo
	if combo == 5 then
		character:SetAttribute("Combo", 1)
	else
		character:SetAttribute("Combo", combo + 1)
	end

	-- Cooldowns
	task.delay(m1Speed, function()
		if character then character:SetAttribute("Busy", false) end
	end)

	local cooldownTime
	if combo == 5 then
		cooldownTime = 1.8
	else 
		cooldownTime = m1Speed * 0.8
	end
	
	task.delay(cooldownTime, function()
		if character then 
			character:SetAttribute("Cooldown", false)
			GeneralModule.removeSpeedBuff(character, "M1SpeedBuff")
		end
	end)

	-- Combo reset
	local comboChanged = false
	local conn
	conn = character:GetAttributeChangedSignal("Combo"):Connect(function()
		comboChanged = true
		conn:Disconnect()
		conn = nil
	end)
	task.delay(2.2, function()
		if character and comboChanged == false then
			character:SetAttribute("Combo", 1)
			conn:Disconnect()
			conn = nil
			if character:FindFirstChild("Humanoid") then 
				character.Humanoid.JumpPower = 50 
			end
			local uptilt = character.PrimaryPart and character.PrimaryPart:FindFirstChild("UptiltLv")
			if uptilt then uptilt:Destroy() end
		end
	end)
end)

-- BLOCKING / PARRYING
blockEvent.OnServerEvent:Connect(function(player)
	local character = player.Character
	if not character then return end
	if character:GetAttribute("Stunned") or character:GetAttribute("Attacking") or 
		character:GetAttribute("Dashing") or character:GetAttribute("Busy") or 
		character:GetAttribute("Blocking") or character:GetAttribute("Parrying") then
		return
	end

	wantToBlock[player] = true
	character:SetAttribute("Parrying", true)
	character:SetAttribute("Sprinting", false)

	GeneralModule.addSpeedBuff(player, "ParrySpeedBuff", -12)

	task.delay(0.333, function()
		if not character or not character.Parent then return end
		GeneralModule.removeSpeedBuff(character, "ParrySpeedBuff")
		character:SetAttribute("Parrying", false)
		
		if wantToBlock[player] then
			character:SetAttribute("Blocking", true)
			GeneralModule.addSpeedBuff(player, "BlockSpeedBuff", -12)

			local blockUI = character:FindFirstChild("BlockingGui")
			if not blockUI then
				blockUI = rs.UIObjects.BlockingGui:Clone()
				blockUI.Parent = character
				blockUI.Adornee = character.Torso
			end
		else
			character:SetAttribute("Blocking", false)
		end
	end)
end)

unblockEvent.OnServerEvent:Connect(function(player)
	local character = player.Character
	if not character then return end

	wantToBlock[player] = false
	character:SetAttribute("Blocking", false)

	local blockUI = character:FindFirstChild("BlockingGui")
	if blockUI then blockUI:Destroy() end

	GeneralModule.removeSpeedBuff(character, "BlockSpeedBuff")
	GeneralModule.removeSpeedBuff(character, "ParrySpeedBuff")
end)

airtiltEvent.OnServerEvent:Connect(function(player)
	local character = player.Character
	if not character then return end

	if character:GetAttribute("Airtilting") == -1 then
		character:SetAttribute("Airtilting", 0)
		task.delay(2, function()
			if character and not character:GetAttribute("Attacking") then
				character:SetAttribute("Airtilting", -1)
			end
		end)
	end
end)
