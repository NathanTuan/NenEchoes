local rs = game:GetService("ReplicatedStorage")
local GameModules = require(rs.GameModules)
local GeneralModule = GameModules.GeneralModule
local openSetUI = rs.RemoteEvents.UIEvents.OpenSetUI
local closeSetUI = rs.RemoteEvents.UIEvents.CloseSetUI
local IHateUI = rs.RemoteEvents.UIEvents.IHateUI


IHateUI.OnServerEvent:Connect(function(player, bool)
	if bool ~= nil then
		player.Character:SetAttribute("AbilityEnabled", bool)
		
	else
		player.Character:SetAttribute("AbilityEnabled", not player.Character:GetAttribute("AbilityEnabled"))
		
	end
	player.Character:SetAttribute("M1Activated", false)
	if player.Character:GetAttribute("AbilityEnabled") == true then
		openSetUI:FireClient(player)
	else
		closeSetUI:FireClient(player)
	end
end)


rs.RemoteEvents.UIEvents.LockMouseEvent.OnServerEvent:Connect(function(player, bool)
	rs.RemoteEvents.UIEvents.LockMouseEvent:FireClient(player, bool)
end)

rs.RemoteEvents.UIEvents.CameraEffectEvent.OnServerEvent:Connect(function(player, bool)
	if bool == true then
		player.Character:SetAttribute("MovementBlocked", true)
		local hum = player.Character.Humanoid
		
		if hum then
			hum.WalkSpeed = 0
			hum.JumpPower = 0
		end
		
		for i, v in pairs(hum.Animator:GetPlayingAnimationTracks()) do
			if v.Priority ~= Enum.AnimationPriority.Idle then
				v:Stop(0.15)
			end
		end
	else
		player.Character:SetAttribute("MovementBlocked", false)
		local hum = player.Character.Humanoid

		if hum then
			hum.WalkSpeed = player.Character:GetAttribute("Speed") + GeneralModule.getSpeedBuffs(player.Character)
			hum.JumpPower = 50
		end
	end
	
end)

