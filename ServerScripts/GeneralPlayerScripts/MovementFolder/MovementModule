local function getActiveState(player)
	if not player.Character then return "Default" end

	local weapon = player.Character:GetAttribute("Weapon")

	-- Check for scythe
	if weapon == "SpawnedScythe" then
		return "Scythe"
	end

	if player.Character:GetAttribute("Swimming") then
		return "Swimming"
	end
	
	-- Check for skateboard (when equipped/driving)
	if player.Character:FindFirstChild("SkateboardSpeedBuff") then
		return "Skateboard"
	end
	
	if player.Character:FindFirstChild("Compass") then
		return "Compass"
	end
	
	return "Default"
end

-- Get the animation name for a specific action in the current state
function AnimationSelector.getAnimName(player, action)
	local state = getActiveState(player)
	--print("State: "..state)
	local anim = animationMap[state] and animationMap[state][action]

	if not anim then
		anim = animationMap["Default"][action]
	end

	return anim
end

-- Play animation based on character state
local function yieldAllPlay(hum, anim, anims)
	local animOriginType = nil
	local clip
	if anims and type(anims) == "table" then
		animOriginType = "table"
	else
		animOriginType = "animation"
		clip = hum.Animator:LoadAnimation(anims):Play()
	end
	local found = false
	for i, v in pairs(hum.Animator:GetPlayingAnimationTracks()) do
		--print(v.Name)
		if (v.Name ~= anim) then
			if v.Priority ~= Enum.AnimationPriority.Idle and v.Priority == Enum.AnimationPriority.Movement then
				v:Stop(0.15)
				--print("Stopped because not Idle")
			else
				if animOriginType == "table" then
					if anims[anim].Priority == Enum.AnimationPriority.Idle and v.Priority == Enum.AnimationPriority.Idle then
						--print("Was Idle and anim was Idle (table")
						v:Stop(0.15)
					end
				else
					if clip.Priority == Enum.AnimationPriority.Idle and v.Priority == Enum.AnimationPriority.Idle then
						--print("Was Idle and anim was Idle (not table")
						v:Stop(0.15)
					end
				end
			end
		elseif v.Name == anim then
			found = true
		end
	end

	if found == false then
		--print("NotFound")
		if anims and type(anims) == "table" then
			anims[anim]:Play(0.15)
		else
			clip:Play()
		end
	end
end

function AnimationSelector.play(player, action, anims)
	if not player.Character then return end

	local hum = player.Character.Humanoid
	local animName = AnimationSelector.getAnimName(player, action)
	
	--print("Playing animation:", animName)
	if animName then
		yieldAllPlay(hum, animName, anims)
	else
		warn("Animation not found for action:", action)
	end
end


return {
	AnimationSelector = AnimationSelector,
}
