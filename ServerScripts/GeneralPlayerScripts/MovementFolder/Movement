local climbRange = 4     -- Distance in front to check
local climbHeight = 6    -- Maximum height diff allowed

local function getLedge(player)
	local hrp = player.Character and player.Character.PrimaryPart
	if not hrp then return nil end

	local rayOrigin = hrp.Position
	local rayDirection = hrp.CFrame.LookVector * climbRange
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {player.Character}
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude

	local result = workspace:Raycast(rayOrigin, rayDirection, raycastParams)
	if result and result.Instance.CollisionGroup ~= "NormalPlayerCollide" and result.Instance.CollisionGroup ~= "TempNoCollide" then
		local topY = result.Position.Y + 0.5 -- Hits top edge of hit surface or part top
		-- Calculate top Y based on hit object bounds if fully wall-facing
		topY = math.max(topY, result.Instance.Position.Y + (result.Instance.Size.Y / 2))

		local heightDiff = topY - hrp.Position.Y
		if heightDiff > 0 and heightDiff <= climbHeight then
			return topY, heightDiff
		end
	end
	return nil, 0
end

rs.RemoteEvents.MovementEvents.ClimbEvent.OnServerEvent:Connect(function(player)
	local char = player.Character
	if not char then return end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not hrp or not humanoid or char:GetAttribute("Stunned") then return end


	local ledgeGoalY, heightNeeded = getLedge(player)

	if ledgeGoalY then
		player.Character:SetAttribute("Climbing", true)
		GeneralModule.stun(player.Character, 0.75, true)
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)
		humanoid.AutoRotate = false

		local climb = humanoid.Animator:LoadAnimation(rs.Animations.MovementAnims.GeneralMovementAnims.ClimbingAnim)
		climb:Play()


		local attachment = Instance.new("Attachment")
		attachment.Parent = hrp

		local linearVelocity = Instance.new("LinearVelocity")
		linearVelocity.Attachment0 = attachment
		linearVelocity.MaxForce = math.huge
		linearVelocity.VectorVelocity = Vector3.new(0, 0, 0) 
		linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
		linearVelocity.Parent = hrp

		hrp.CFrame = CFrame.new(Vector3.new(hrp.Position.X, ledgeGoalY - heightNeeded, hrp.Position.Z))
		local dustVFX = rs.VFX.CombatVFX.DustVFX
		local goalCFrame = hrp.CFrame * CFrame.new(0, -2, 0)
		rs.RemoteEvents.UIEvents.CreateVFXEvent:FireClient(player, dustVFX, goalCFrame, 1, "Emit")

		linearVelocity.VectorVelocity = Vector3.new(0, 12, 0) 
		-- 4. Calculate exact duration based on speed and height needed
		local speed = linearVelocity.VectorVelocity.Y
		local climbDuration = (heightNeeded + 2.5) / speed

		task.wait(climbDuration)

		local forwardSpeed = 10
		local forwardDuration = 0.25
		linearVelocity.VectorVelocity = hrp.CFrame.LookVector * forwardSpeed
		task.wait(forwardDuration)

		linearVelocity:Destroy()
		attachment:Destroy()


		--hrp.CFrame = CFrame.new(Vector3.new(hrp.Position.X, ledgeGoalY + 1.5, hrp.Position.Z)) + (hrp.CFrame.LookVector * 1.5)
		humanoid.AutoRotate = true
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		player.Character:SetAttribute("Climbing", false)
	end
end)

