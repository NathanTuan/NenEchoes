-- Movement Speed Configurations
local WALK_SPEED = 16
local SPRINT_SPEED = 28
local SWIM_SPEED = 20
local checkList = {"Stunned", "Ragdolled", "Driving", "MovementBlocked", "Blocking", "Parrying", "Busy", "Incapacitated"}

-- Handles Direction / Movement Updates
moveEvent.OnServerEvent:Connect(function(player, netD)
	local character = player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	if not GeneralModule.checkAll(player, checkList) then return end

	-- Server tracks player's movement direction state if needed for mechanics
	character:SetAttribute("CurrentDirection", netD)
end)

sprintEvent.OnServerEvent:Connect(function(player, isSprinting)
	local character = player.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	if not GeneralModule.checkAll(player, checkList) then return end

	if isSprinting and not character:GetAttribute("Swimming") and not character:GetAttribute("Attacking") then
		character:SetAttribute("Sprinting", true)
		character:SetAttribute("Speed", SPRINT_SPEED)
		humanoid.WalkSpeed = SPRINT_SPEED + GeneralModule.getSpeedBuffs(player.Character)
	else
		character:SetAttribute("Sprinting", false)
		character:SetAttribute("Speed", WALK_SPEED)
		humanoid.WalkSpeed = WALK_SPEED + GeneralModule.getSpeedBuffs(player.Character)
	end
end)


