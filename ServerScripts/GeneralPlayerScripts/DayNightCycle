local lightingService = game:GetService("Lighting")


local dayLength = 1200 --in seconds
local nightLength = 600 
local offset = 3 --offset (hrs)

while true do
	-- Day time: 6 AM to 6 PM
	for i = (6+offset) * 60, 18 * 60 do
		lightingService:SetMinutesAfterMidnight(i)
		wait(dayLength / (12 * 60)) 
	end

	-- Night time: 6 PM to 6 AM
	for i = (18+offset) * 60, 24 * 60 do
		lightingService:SetMinutesAfterMidnight(i)
		wait(nightLength / (12 * 60)) 
	end

	for i = (0+offset), 6 * 60 do
		lightingService:SetMinutesAfterMidnight(i)
		wait(nightLength / (12 * 60)) 
	end
end
