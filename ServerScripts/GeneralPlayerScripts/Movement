				createLightningTrail(v.Position, moveDir*-1)
			end
		end
		task.wait(0.08)
	else 
		local hum = player.Character.Humanoid
		local originalHipHeight = hum.HipHeight
		hum.HipHeight = originalHipHeight + 1.5
		
		GeneralModule.addSpeedBuff(player, "dashSpeedBuff", 60)
		task.wait(0.25)
