end)

local checkList = {"Stunned", "Ragdolled", "Driving", "MovementBlocked", "Blocking", "Parrying", "Busy"}

moveEvent.OnServerEvent:Connect(function(player, value)
	local character = player.Character
	character:SetAttribute("NetDirection", value)
	local hum = character:WaitForChild("Humanoid")
	local dir = value

	local anims = movementManager:GetAnimations(player.Character)
	if not anims then return end

	if not character:GetAttribute("Sprinting") then
		local checks = GeneralModule.checkAll(player, checkList) 
		if checks == false then 
			--AnimationSelector.play(player, "idle", anims)
			return 
		end 
		character:SetAttribute("Speed", 16) 
		local speedBuff = 0
		for _, v in pairs(character:GetChildren()) do
			if v:IsA("IntValue") and string.find(v.Name, "SpeedBuff") then
				speedBuff = speedBuff + v.Value
			end
		end
		character.Humanoid.WalkSpeed = character:GetAttribute("Speed") + speedBuff

		-- Use modular animation selector
		if dir == "w" then
			AnimationSelector.play(player, "walk", anims)
		elseif dir == "a" then
			AnimationSelector.play(player, "leanLeft", anims)
		elseif dir == "d" then
			AnimationSelector.play(player, "leanRight", anims)
		elseif dir == "s" then
			AnimationSelector.play(player, "walk", anims)
		else
			AnimationSelector.play(player, "idle", anims)
		end
	else
		local checks = GeneralModule.checkAll(player, checkList) 
		if checks == false then 
			AnimationSelector.play(player, "idle", anims)
			return 
		end 
		character:SetAttribute("Speed", 24) 
		local speedBuff = 0
		for _, v in pairs(character:GetChildren()) do
			if v:IsA("IntValue") and string.find(v.Name, "SpeedBuff") then
				speedBuff = speedBuff + v.Value
			end
		end
		character.Humanoid.WalkSpeed = character:GetAttribute("Speed") + speedBuff

		-- Use modular animation selector for sprinting
		if dir == "w" then
			AnimationSelector.play(player, "sprint", anims)
		elseif dir == "a" then
			AnimationSelector.play(player, "sprintLeft", anims)
		elseif dir == "d" then
			AnimationSelector.play(player, "sprintRight", anims)
		else
			AnimationSelector.play(player, "idle", anims)
		end
	end
end)

jumpEvent.OnServerEvent:Connect(function(player)
	if player.Character:GetAttribute("Driving") == true then
		local skateboard = player.Character:FindFirstChild("Skateboard")
		local m6D = skateboard.Handles.SkateboardWeld
		if skateboard then
			for _, part in pairs(skateboard.SkateboardModel:GetChildren()) do
			end


			local originalC0 = m6D.C0
			local spinDegrees = 360
			local spinTime = 0.375
			local elapsed = 0

			local connection
			connection = game:GetService("RunService").Heartbeat:Connect(function(dt)
				elapsed += dt
				local alpha = math.clamp(elapsed / spinTime, 0, 1)
				local rotation = math.rad(spinDegrees) * alpha
				m6D.C0 = originalC0 * CFrame.Angles(0, 0, rotation)

				if alpha >= 1 then
					connection:Disconnect()
					m6D.C0 = originalC0 * CFrame.Angles(0, 0, math.rad(spinDegrees))
					for _, part in pairs(skateboard.SkateboardModel:GetChildren()) do
						part.CanCollide = true
						part.CanTouch = true
					end
				end
			end)
		end
	end

	local checks = GeneralModule.checkAll(player)
	if checks == false or player.Character:GetAttribute("Busy") == true then return end
	GeneralModule.yieldAllBut(player.Character, "")
	local anims = movementManager:GetAnimations(player.Character)
	AnimationSelector.play(player, "jump", anims)
end)

landEvent.OnServerEvent:Connect(function(player)
	yieldAllBut(player.Character.Humanoid, "")
	local anims = movementManager:GetAnimations(player.Character)
	AnimationSelector.play(player, "endJump", anims)

	GeneralModule.stun(player.Character, 1)
	task.wait()
	anims.endJump.Stopped:Connect(function()
		moveEvent:FireClient(player)
	end)
end)

-- ===== VFX HELPERS (unchanged) =====
local draw = function(p1, p2, x, y)
	local dist = (p2.Position-p1.Position).Magnitude
	local part = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.Color = Color3.fromRGB(137, 243, 255)
	part.Material = Enum.Material.Neon
	part.Size = Vector3.new(0.6-x, 0.6-y, dist)
	part.CFrame = CFrame.new(p1.Position, p2.Position) * CFrame.new(0, 0, -1*dist/2)

	local partt = rs.VFX.KilluaVFX.lineTPAttHolder:Clone()
	local att = partt.lineTPAtt:Clone()
	partt:Destroy()
	att.Parent = part

	part.Parent = game.Workspace
	local tween = tweenService:Create(part, tweenInfo, {Transparency = 1}):Play()
	game:GetService("Debris"):AddItem(part, 1)
end

local createLightningTrail = function(makePos, dashDir)
	local addZ = 0
	local x= 0
	local y = 0
	for i=1, 5, 1 do
		local part = Instance.new("Part")
		part.Name = "BezierPoint"..tostring(i)
		local randX = math.random(-2, 2)
		local randY = math.random(-0.3, 0.3)

		local offset = dashDir * addZ
		local sideOffset = dashDir:Cross(Vector3.yAxis) * randX
		local heightOffset = Vector3.new(0, 1+randY, 0)
		local finalPos = makePos + offset + sideOffset + heightOffset

		part.Position = finalPos
		part.Anchored = true
		part.CanCollide = false
		part.BrickColor= BrickColor.new("Medium blue")
		part.Material = Enum.Material.Neon
		part.Size = Vector3.new(0.5, 0.5, 0.5)
		part.CFrame = CFrame.new(finalPos, finalPos + dashDir)
		part.Transparency = 1
		part.Parent = game.Workspace
		addZ= addZ+3.5
		x = x+0.1
		y = y+0.1
		game:GetService("Debris"):AddItem(part, 1)
		if i>1 then
			draw(game.Workspace["BezierPoint"..tostring((i-1))], part, x, y)
		end
	end
end


