local rs = game:GetService("ReplicatedStorage")
local GameModules = require(rs.GameModules)
local modScript = GameModules.GeneralModule
local tweenService = game:GetService("TweenService")
local tweenInfo = TweenInfo.new(1, Enum.EasingStyle.Quad)
local tweenInfo2 = TweenInfo.new(0.8, Enum.EasingStyle.Quad)


local sphereEvent = rs.RemoteEvents.NenAbilities.NobunagaMoves.Z
local counterAnim = rs.NenAbilities.Nobunaga.NobunagaAnims.counterAnim
local counterFinishAnim = rs.NenAbilities.Nobunaga.NobunagaAnims.counterFinishAnim
local cdManager = GameModules.CooldownManagerModule
local cdScript = GameModules.NenAbilityInfoModule
local animationManager= require(script.Parent.NenAbilityAnimationManager)

sphereEvent.OnServerEvent:Connect(function(player)
	
	local checks = modScript.checkAll(player)
	if checks == false then
		return 
	end
	
	local anims = animationManager:GetAnimations(player.Character)
	
	if cdManager.IsOnCooldown(player, "Z") then
		return
	else
		cdManager.SetCooldown(player, "Z", 1)--cdScript.Nobunaga.Z.Cooldown)
	end
	
	modScript.yieldAllBut(player.Character, "F")
	modScript.stun(player.Character, 2.2)
	local sphere = rs.VFX.CombatVFX.NenSphere:Clone()
	sphere.Position = player.Character.HumanoidRootPart.Position + Vector3.new(0, -1, 0)
	sphere.Parent = player.Character.HumanoidRootPart
	
	local motor = Instance.new("Motor6D")
	motor.Parent = sphere
	motor.Part0 = sphere
	motor.Part1 = player.Character.HumanoidRootPart
	task.wait(0.05)
	sphere.Attachment.Crescents:Emit(sphere.Attachment.Crescents:GetAttribute("EmitCount"))
	sphere.Attachment.Ring:Emit(sphere.Attachment.Ring:GetAttribute("EmitCount"))
	sphere.Attachment2.Symbol:Emit(sphere.Attachment2.Symbol:GetAttribute("EmitCount"))
	local size = Vector3.new(50, 50, 50)

	
	local tween = tweenService:Create(sphere, tweenInfo2, {Size = size})
	local tween2 = tweenService:Create(sphere, tweenInfo2, {Transparency = 1})
	tween:Play()


	anims.counterClip:Play()

	tween.Completed:Connect(function()
		game:GetService("Debris"):AddItem(sphere, 1.8)
		task.wait(0.4)
		tween2:Play()
		task.wait(1.6)
		anims.counterClip:Stop()
	end)
	task.wait(1)
	local alreadyHit = {}
	local params = OverlapParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = {sphere, player.Character}
	local originalPos = player.Character.HumanoidRootPart.CFrame
	local hits = workspace:GetPartBoundsInBox(sphere.CFrame, sphere.Size, params)
	
	for _, hit in pairs(hits) do
	
	
		local hum = hit.Parent:FindFirstChild("Humanoid")
		if hum and not alreadyHit[hum.Parent] then
			alreadyHit[hum.Parent] = true
			
			modScript.setCollisionGroup(hit.Parent,4)
			modScript.setCollisionGroup(player.Character, 4)
			
			modScript.stun(hum.Parent, 2)
			anims.counterClip:Stop()
			anims.counterFinishClip:Play()
			
			local hrpPos = player.Character.PrimaryPart.Position
			local startPos = hrpPos
			local dir = (hit.Parent.HumanoidRootPart.Position-hrpPos)
			local endPos = startPos + dir.Unit * 20
			
			--modScript.createHitEffect(startPos + dir.Unit*10, rs.VFX.CombatVFX.BoostVFXRed)
			local boostVFX = rs.VFX.CombatVFX.BoostVFXRed:Clone()
			boostVFX.Position = startPos + dir.Unit*10
			boostVFX.Parent = game.Workspace
			task.delay(0.1, function()
				game:GetService("Debris"):AddItem(boostVFX, 1)
				for _, emitter in pairs(boostVFX.Core:GetChildren()) do
					emitter:Emit(5)
				end
			end)
			
			local rayParams = RaycastParams.new()
			rayParams.FilterDescendantsInstances = {player.Character, hit.Parent}
			rayParams.FilterType = Enum.RaycastFilterType.Exclude

			local rayResult = workspace:Raycast(startPos, endPos - startPos, rayParams)

			if not rayResult then
				player.Character.HumanoidRootPart.CFrame = CFrame.new(endPos)
			else
				print("blocked above target, skipping teleport")
			end
			
			
			modScript.createHitEffect(originalPos.Position, rs.VFX.blackFX)
			modScript.displayText(player, "死")
			hum:TakeDamage(20)
			modScript.createHitEffect(hum.Parent.PrimaryPart.Position, rs.VFX.CombatVFX.domainSlashFX)
			modScript.damageLooks(player, hit, 20)
			--modScript.knockback(player.Character, hum.Parent, 40)
			task.spawn(function()
				
				for i=1, 10, 1 do
					local part = Instance.new("Part")
					part.Color = Color3.fromRGB(126, 104, 63)
					part.Anchored = false
					part.Massless = true
					part.Material = Enum.Material.Ground
					part.CanCollide = false
					part.CanTouch = false
					part.CanQuery = false

					local size = math.random(1, 3)
					part.Size = Vector3.new(size, size, size)

					local x = math.random(-5, 5)
					local z = math.random(-5, 5)
					local hrpPos = player.Character.HumanoidRootPart.Position
					part.Position = Vector3.new(hrpPos.X + x, hrpPos.Y-2, hrpPos.Z + z) +  dir.Unit*-10
					part.Parent = game.Workspace
					part.AssemblyLinearVelocity =  Vector3.new(0, 50, 0)--player.Character.HumanoidRootPart.CFrame.RightVector * math.random(-1, 1) * 15 + Vector3.new(0, 50, 0)
					
					
					game:GetService("Debris"):AddItem(part, 3)
				end
				
				task.wait(0.1)
				modScript.createHitEffect(player.Character.PrimaryPart.CFrame.Position, rs.VFX.blackFX)
				anims.counterFinishClip:Stop()
				anims.counterClip:Play()
				--player.Character.HumanoidRootPart.CFrame = originalPos
				
				
				
			end)
		end
		
	end
	
end)


rs.RemoteEvents.NenAbilities.NobunagaMoves.X.OnServerEvent:Connect(function(player, target)
	
	local checks = modScript.checkAll(player)
	if checks == false then return end
	
	if cdManager.IsOnCooldown(player, "X") then
		print("On CD")
		return
	else
		cdManager.SetCooldown(player, "X", cdScript.Nobunaga.X.Cooldown)
	end
	
	local anims = animationManager:GetAnimations(player.Character)
	local hrp = player.Character.PrimaryPart
	local direction = (target-hrp.Position).Unit*27
	local vectorGoal = direction + hrp.Position

	local hitbox = rs.VFX.Hitboxes.KilluaHitboxes.thunderboltHitbox:Clone()
	hitbox.CFrame = CFrame.lookAt(hrp.Position, vectorGoal) * CFrame.new(0, 0, -14)
	hitbox.Parent = game.Workspace
	hitbox.Name = "CMoveBox"
	game:GetService("Debris"):AddItem(hitbox, 0.1)

	anims.counterClip:Play()
	task.delay(1, function()
		anims.counterClip:Stop()
		anims.counterFinishClip:Play()
		modScript.displayText(player, "居合道弾幕")
		task.wait(2)
		anims.counterFinishClip:Stop()
	end)
	modScript.applyAttackingState(player.Character, 2)
	task.wait(1)
	for i=1,10,1 do
		local hitboxParams = OverlapParams.new()
		hitboxParams.FilterType = Enum.RaycastFilterType.Exclude
		hitboxParams.FilterDescendantsInstances = {player.Character, hitbox}
		local hits = workspace:GetPartBoundsInBox(hitbox.CFrame, hitbox.Size, hitboxParams)
		local hitPlayers = {}

		for _, hit in hits do

			local hum = hit.Parent:FindFirstChild("Humanoid")
			if hum and not hitPlayers[hit.Parent] then
				hitPlayers[hit.Parent] = true
				modScript.stun(hit.Parent, 0.2)
				modScript.damageLooks(player, hit, 2)
				hum:TakeDamage(2)
				modScript.createHitEffect(hum.Parent.PrimaryPart.Position, rs.VFX.CombatVFX.counterFX)
			end
		end
		
		task.wait(0.1)
	end
	
end)
