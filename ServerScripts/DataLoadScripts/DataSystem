local ExistingQuests = {
	["Island1"] = 3,
	["Island2"] = 2,
}
local function createQuestFolders(player, questFolder)
	for i, island in pairs(ExistingQuests) do
		local islandFolder = Instance.new("Folder", questFolder)
		islandFolder.Name = i
		
		for j=1, ExistingQuests[islandFolder.Name], 1 do
			local batchFolder = Instance.new("Folder", islandFolder)
			batchFolder.Name = "Batch"..tostring(j)
			
			local stageValue = Instance.new("IntValue", batchFolder)
			stageValue.Name = "Stage"
			stageValue.Value = 1
			
			local branchValue = Instance.new("IntValue", batchFolder)
			branchValue.Name = "Branch"
			branchValue.Value = 1
		end
	end
	
	rs.RemoteEvents.UIEvents.StartQuestUI:FireClient(player, questFolder)
end

