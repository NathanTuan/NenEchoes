	if action == "Add" then
		local item = player.Hotbar:FindFirstChild(itemName)
		if not item then 
			item = Instance.new("IntValue")
			item.Name = itemName
			item.Value = value
			item.Parent = player.Hotbar
		end
	else
		local item = player.Hotbar:FindFirstChild(itemName)
		if item then
