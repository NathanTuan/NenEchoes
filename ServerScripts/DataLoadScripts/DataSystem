local pantsArray = rs.Outfits.Pants:GetChildren()
local shoesArray = rs.Outfits.Shoes:GetChildren()
local eyesArray  = rs.Outfits.Eyes:GetChildren()
local nosesArray = rs.Outfits.Noses:GetChildren()
local mouthsArray = rs.Outfits.Mouths:GetChildren()

local itemMap = {
	["Hair"] = "Head",
	["Shirt"] = "Torso",
	["Sleeves"] = {
		"Right Arm",
		"Left Arm",
	},
	["Pants"] = {
		"Right Leg",
		"Left Leg",
	},
	["Shoes"] = {
