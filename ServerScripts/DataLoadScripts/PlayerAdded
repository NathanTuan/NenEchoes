		clothesFolder.Name = "Clothes"
		clothesFolder.Parent = player.Character
		
		local att = Instance.new("Attachment")
		att.Parent = character.PrimaryPart
		att.Name = "dashAtt"
		
		
		if game.Workspace.Summons[player.Name] then
			for _, v in pairs(game.Workspace.Summons[player.Name]:GetChildren()) do
				v:Destroy()
			end
		end	
		
		task.spawn(function()
			local attempts, maxAttempts = 1, 4
			while attempts < maxAttempts and not gameStartTable[player] do
				--print("Trying")
				attempts = attempts + 1
				task.wait(1*attempts)
			end
			if gameStartTable[player] then
				task.spawn(function()
					--print("Updating clothes")
					updateClothes(player)
					task.wait(0.5)
					updateClothesColors(player, player.ClothesIDs.HairColor.Value, player.ClothesIDs.ShirtColor.Value, player.ClothesIDs.SleevesColor.Value, player.ClothesIDs.PantsColor.Value, player.ClothesIDs.ShoesColor.Value)
					task.wait(2)
					updateClothesColors(player, player.ClothesIDs.HairColor.Value, player.ClothesIDs.ShirtColor.Value, player.ClothesIDs.SleevesColor.Value, player.ClothesIDs.PantsColor.Value, player.ClothesIDs.ShoesColor.Value)
				end)
				
				local bool = PhysicsService:IsCollisionGroupRegistered("TempNoCollide")
				while not bool do
					bool = PhysicsService:IsCollisionGroupRegistered("TempNoCollide")
					task.wait(1)
					print("Waiting for group tempnocollide")
				end
				setCollisionGroup(character, "NormalPlayerCollide")
				
				local hum = character:WaitForChild("Humanoid")
				task.wait(1)
				hum.MaxHealth = 100 + player.Stats.Health.Value
				hum.Health = hum.MaxHealth
				character:SetAttribute("Nen", 100+player.Stats.Nen.Value)	
				rs.StatRemoteEvents.CharacterAddedEvent:FireClient(player)
			end
		end)
		
		
		
		
		
		local conn
		local hum = character:WaitForChild("Humanoid")
		hum:SetStateEnabled(Enum.HumanoidStateType.Dead, false)
		conn = hum.HealthChanged:Connect(function(health)
			
			if character:GetAttribute("Incapacitated") == true then return end
			--print("newHealth: "..tostring(health))
			if health <= 0 then
				print("KnockedTHing")
				character:SetAttribute("Incapacitated", true)
				character:SetAttribute("Invincible", true)

				-- Ragdoll and knockback
				ragdollModule:Ragdoll(character, 10)
				modScript.knockback(character, character, -5)

				-- Create timer UI
				local timer = rs.UIObjects.KnockedTimer:Clone()
				timer.Name = "IncapacitatedTimer"
				timer.Parent = character.Torso
				timer.Adornee = character.Torso

				-- 10 second countdown
				for i = 10, 1, -1 do
					timer.TextLabel.Text = i
					task.wait(1)
				end

				-- Recovery
				timer:Destroy()
				hum:ChangeState(Enum.HumanoidStateType.GettingUp)
				hum.Health = hum.MaxHealth
				character:SetAttribute("Incapacitated", false)
				task.wait(1)
				character:SetAttribute("Invincible", false)
				
			end
			
		end)
		
	end)

	player:LoadCharacterAsync()
end)



